{
  "expo": {
    "name": "Quits",
    "slug": "quits",
    "description": "Split shared costs with friends, and settle up in the fewest payments.",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quits",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F3EE",
    "ios": {
      "bundleIdentifier": "com.ahmadbasraa.quits",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.studio.quits",
      "adaptiveIcon": {
        "backgroundColor": "#8B6CFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "Quits",
      "shortName": "Quits",
      "themeColor": "#8B6CFF",
      "backgroundColor": "#F5F3EE",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#8B6CFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#A08CFF",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/quits"
    }
  }
}
